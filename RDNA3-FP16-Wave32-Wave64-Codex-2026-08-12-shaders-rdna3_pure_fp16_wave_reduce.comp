// 해당코드는 Codex로 수정됨
#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_subgroup_extended_types_float16 : require

// A single shader module is shared by both pipelines. Vulkan selects Wave32 or
// Wave64 with VkPipelineShaderStageRequiredSubgroupSizeCreateInfo.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputFP16 {
    float16_t inputData[];
};

layout(set = 0, binding = 1, std430) writeonly buffer ElementOutputFP16 {
    float16_t elementData[];
};

layout(set = 0, binding = 2, std430) writeonly buffer SubgroupOutputFP16 {
    float16_t subgroupData[];
};

layout(push_constant, std430) uniform DispatchInfo {
    uint elementCount;
} dispatchInfo;

void main() {
    const uint index = gl_GlobalInvocationID.x;
    const bool valid = index < dispatchInfo.elementCount;

    // Invalid lanes contribute FP16 zero. Every launched lane still reaches the
    // subgroup operation, so a partial final dispatch has well-defined padding.
    float16_t transformed = float16_t(0.0);
    if (valid) {
        const float16_t value = inputData[index];
        const float16_t squared = value * value;
        transformed = squared + float16_t(2.0);
        elementData[index] = transformed;
    }

    // The argument, accumulation result and destination are all FP16.
    const float16_t subgroupSum = subgroupAdd(transformed);

    // local_size_x is 64: Wave32 writes two sums per workgroup, while Wave64
    // writes one. Only one elected lane writes each subgroup result.
    if (subgroupElect()) {
        const uint outputIndex =
            gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID;
        subgroupData[outputIndex] = subgroupSum;
    }
}
